# =========================================================
# RFIDS-X ENVIRONMENT CONFIGURATIONS
# =========================================================

# Application Config
NODE_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:5173

# Database configuration (PostgreSQL via Drizzle)
DATABASE_URL=postgres://rfids_user:securepassword@localhost:5432/rfids_db

# Security
JWT_SECRET=super_secret_for_local_dev_change_me
CORS_ORIGIN=*

# AI Threat Tracking Integration
AI_ENGINE_ENABLED=true
AI_ENGINE_URL=http://localhost:5000
TENSOR_CORES=enable
THREAT_DETECTION_MODEL_PATH=/opt/models/rf_tracker_v3.bin

# Email/Logging Service (Simulated)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=dummy_user
SMTP_PASS=dummy_pass
